<!DOCTYPE html>
<html lang="pt-br">
<head>

    <meta charset="UTF-8">

    <meta name="viewport"
    content="width=device-width, initial-scale=1.0">

    <title>Noxzon</title>

    <link rel="stylesheet"
    href="/css/nx-style.css">

    <link rel="icon"
    href="/img/noxzon-logo.jpg">

</head>

<body>

    <%- include("../partes/navbar") %>

    <%- include("../partes/hero") %>

    <!-- SEARCH -->

    <section class="search-section">

        <form
        action="/search"
        method="GET"
        class="search-form"
        >

            <input
            type="text"
            name="q"
            placeholder="Pesquisar filmes, séries ou mangás..."
            required
            >

            <button type="submit">

                Pesquisar

            </button>

        </form>

    </section>

    <!-- CONTINUE WATCHING -->

    <% if(continueWatching.length > 0){ %>

    <section class="continue-section">

        <h2>
            Continuar Assistindo
        </h2>

        <div class="continue-grid">

            <% continueWatching.forEach(item => { %>

                <% if(item.media){ %>

                    <a
                    class="continue-card"
                    href="/watch/<%= item.media._id %>/1"
                    >

                        <img
                        src="<%= item.media.image %>"
                        alt="<%= item.media.title %>"
                        >

                        <div class="continue-info">

                            <h3>
                                <%= item.media.title %>
                            </h3>

                            <span>
                                Continuar assistindo
                            </span>

                        </div>

                    </a>

                <% } %>

            <% }) %>

        </div>

    </section>

    <% } %>

    <!-- HERO BANNER -->

    <% if(medias.length > 0){ %>

    <section class="hero-banner">

        <img
        src="<%= medias[0].image %>"
        alt="<%= medias[0].title %>"
        >

        <div class="hero-overlay">

            <span>
                Destaque Noxzon
            </span>

            <h1>
                <%= medias[0].title %>
            </h1>

            <p>
                <%= medias[0].description %>
            </p>

            <a
            href="/watch/<%= medias[0]._id %>/1"
            >

                <button>
                    Assistir Agora
                </button>

            </a>

        </div>

    </section>

    <% } %>

    <!-- ANIMES -->

    <section class="category-section">

        <h2>Animes</h2>

        <div class="catalog-grid">

            <% medias
            .filter(media => media.category === "Anime")
            .forEach(media => { %>

                <a
                href="/media/<%= media._id %>"
                class="media-card"
                >

                    <img
                    src="<%= media.image %>"
                    alt="<%= media.title %>"
                    >

                    <div class="media-info">

                        <span class="media-type">
                            <%= media.type %>
                        </span>

                        <h3>
                            <%= media.title %>
                        </h3>

                    </div>

                </a>

            <% }) %>

        </div>

    </section>

    <!-- FILMES -->

    <section class="category-section">

        <h2>Filmes</h2>

        <div class="catalog-grid">

            <% medias
            .filter(media => media.category === "Filme")
            .forEach(media => { %>

                <a
                href="/media/<%= media._id %>"
                class="media-card"
                >

                    <img
                    src="<%= media.image %>"
                    alt="<%= media.title %>"
                    >

                    <div class="media-info">

                        <span class="media-type">
                            <%= media.type %>
                        </span>

                        <h3>
                            <%= media.title %>
                        </h3>

                    </div>

                </a>

            <% }) %>

        </div>

    </section>

    <!-- SÉRIES -->

    <section class="category-section">

        <h2>Séries</h2>

        <div class="catalog-grid">

            <% medias
            .filter(media => media.category === "Série")
            .forEach(media => { %>

                <a
                href="/media/<%= media._id %>"
                class="media-card"
                >

                    <img
                    src="<%= media.image %>"
                    alt="<%= media.title %>"
                    >

                    <div class="media-info">

                        <span class="media-type">
                            <%= media.type %>
                        </span>

                        <h3>
                            <%= media.title %>
                        </h3>

                    </div>

                </a>

            <% }) %>

        </div>

    </section>

    <!-- MANGÁS -->

    <section class="category-section">

        <h2>Mangás</h2>

        <div class="catalog-grid">

            <% medias
            .filter(media => media.category === "Mangá")
            .forEach(media => { %>

                <a
                href="/media/<%= media._id %>"
                class="media-card"
                >

                    <img
                    src="<%= media.image %>"
                    alt="<%= media.title %>"
                    >

                    <div class="media-info">

                        <span class="media-type">
                            <%= media.type %>
                        </span>

                        <h3>
                            <%= media.title %>
                        </h3>

                    </div>

                </a>

            <% }) %>

        </div>

    </section>

    <%- include("../partes/trailers") %>

    <%- include("../partes/downloads") %>

    <%- include("../partes/footer") %>

</body>
</html>