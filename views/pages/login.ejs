    <title>Noxzon</title>

    <link rel="stylesheet" href="/css/nx-style.css">
    <link rel="icon" href="/img/noxzon-logo.jpg">

    <%- include("../partes/navbar") %>

    <section class="login-page">

        <div class="login-box">

            <h1>Login</h1>

            <p>
                Entre na sua conta Noxzon.
            </p>

            <form action="/login" method="POST">

                <input 
                    type="email"
                    name="email"
                    placeholder="Seu email"
>

                <input 
                    type="password"
                    name="password"
                    placeholder="Sua senha"
>

                
                <button type="submit">
                    Entrar
                </button>
                

            </form>

            <span>
                Ainda não possui conta?
            </span>

            <a href="/register">
                Criar conta
            </a>

        </div>

    </section>

    <%- include("../partes/footer") %>