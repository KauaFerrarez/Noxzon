<!DOCTYPE html>
<html lang="pt-br">
<head>

    <meta charset="UTF-8">

    <meta name="viewport"
    content="width=device-width, initial-scale=1.0">

    <title>
        Assistir - <%= media.title %>
    </title>

    <link rel="stylesheet"
    href="/css/nx-style.css">
    <link rel="icon" href="/img/noxzon-logo.jpg">

</head>

<script>

setInterval(async () => {

    try{

        await fetch("/save-progress", {

            method: "POST",

            headers: {

                "Content-Type":
                "application/json"

            },

            body: JSON.stringify({

                mediaId:
                "<%= media._id %>",

                time: 10

            })

        });

    }catch(error){

        console.log(error);

    }

}, 10000);

</script>

<body>

    <%- include("../partes/navbar") %>

<section class="watch-page">

    <!-- PLAYER SIDE -->

    <div class="watch-left">

        <div class="watch-player">

            <video
            id="player"

            controls

            autoplay

            width="100%"

            poster="<%= episode.thumbnail %>"
            >

                <source
                src="<%= episode.videoUrl %>"
                type="video/mp4">

            </video>>

        </div>

        <div class="watch-info">

            <span>
                <%= media.category %>
            </span>

            <h1>
                <%= media.title %>
            </h1>

            <h2 class="episode-title">

                Episódio
                <%= episode.episodeNumber %>
                -
                <%= episode.title %>

            </h2>

            <p>
                <%= media.description %>
            </p>

        </div>

    </div>

    <!-- EPISODES SIDE -->

    <div class="episode-list">

        <h3>Episódios</h3>

        <% media.episodes.forEach(ep => { %>

            <a
            class="episode-item"

            href="/watch/<%= media._id %>/<%= ep.episodeNumber %>"
            >

                Episódio <%= ep.episodeNumber %>
                -
                <%= ep.title %>

            </a>

        <% }) %>

    </div>

</section>

    <%- include("../partes/footer") %>

</body>
</html>