<!DOCTYPE html>
<html lang="pt-br">
<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Noxzon</title>

    <link rel="stylesheet" href="/css/nx-style.css">
    <link rel="icon" href="/img/noxzon-logo.jpg">

</head>
<body>

    <%- include("../partes/navbar") %>

    <section class="admin-media-page">

        <h1>
            Gerenciar mídias
        </h1>

        <div class="admin-media-grid">

            <% medias.forEach(media => { %>

                <div class="admin-media-card">

                    <img
                    src="<%= media.image %>"
                    alt="<%= media.title %>"
                    >

                    <div class="admin-media-info">

                        <h2>
                            <%= media.title %>
                        </h2>

                        <p>
                            <%= media.category %>
                        </p>

                        <div class="admin-media-buttons">
                            <a href="/admin/edit/<%= media._id %>">

                                <button class="edit-btn">
                                 Editar
                                </button>

                            </a>

                            <a
                            href="/admin/delete/<%= media._id %>"
                            >

                                <button class="delete-btn">
                                    Deletar
                                </button>

                            </a>

                            <form
                            action="/admin/add-episode/<%= media._id %>"
                            method="POST"
                            enctype="multipart/form-data"
                            >

                                <input
                                    type="text"
                                    name="title"
                                    placeholder="Título do episódio"
                                    required
                                >

                                <input
                                    type="number"
                                    name="episodeNumber"
                                    placeholder="Número do episódio"
                                    required
                                >

                                <label class="upload-video">

                                    📹 Escolher Vídeo

                                    <input
                                        type="file"
                                        name="video"
                                        accept="video/mp4,video/webm"
                                        hidden
                                        required
                                    >

                                </label>

                                <label class="upload-thumb">

                                    Escolher Thumb

                                    <input
                                        type="file"
                                        name="thumbnail"
                                        accept="image/*"
                                        hidden
                                    >

                                </label>

                                <input
                                    type="number"
                                    name="duration"
                                    placeholder="Duração em segundos"
                                >

                                <button type="submit">
                                    Adicionar Episódio
                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    </section>

</body>
</html>