<!DOCTYPE html>
<html lang="pt-br">
<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin - Noxzon</title>

    <link rel="stylesheet" href="/css/nx-style.css">
    <link rel="icon" href="/img/noxzon-logo.jpg">

    <%- include("../partes/navbar") %>

    <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    >

</head>

    <script>

const fileInput =
document.getElementById("fileInput");

const fileName =
document.getElementById("fileName");

fileInput.addEventListener("change", () => {

    if(fileInput.files.length > 0){

        fileName.textContent =
        fileInput.files[0].name;

    }

});

</script>

<body>

    <div class="admin-layout">

        <!-- SIDEBAR -->

        <aside class="admin-sidebar">

            <div class="admin-logo">

                <h1>Noxzon</h1>

                <span>ADMIN</span>

            </div>

            <nav class="admin-nav">

                <a href="#">
                    <i class="fa-solid fa-table-columns"></i>
                    Dashboard
                </a>

                <a href="#" class="active-admin">

                    <i class="fa-solid fa-square-plus"></i>

                    Adicionar mídia

                </a>

                <a href="#">

                    <i class="fa-solid fa-film"></i>

                    Mídias

                </a>

                <a href="#">

                    <i class="fa-solid fa-folder"></i>

                    Categorias

                </a>

                <a href="#">

                    <i class="fa-solid fa-users"></i>

                    Usuários

                </a>

            </nav>

            <a href="/logout" class="admin-logout">

                <i class="fa-solid fa-right-from-bracket"></i>

                Sair

            </a>

        </aside>

        <!-- CONTENT -->

        <main class="admin-content">

            <div class="admin-top">

                <div>

                    <h1>Adicionar mídia</h1>

                    <p>
                        Adicione filmes, séries ou mangás ao catálogo da Noxzon.
                    </p>

                </div>

            </div>

            <div class="admin-box-modern">

                <form
                    action="/admin/add-media"
                    method="POST"
                    enctype="multipart/form-data"
                    class="admin-form"
                >

                    <div class="admin-input-group">

                        <label>Título</label>

                        <input
                        type="text"
                        name="title"
                        placeholder="Digite o título da mídia"
                        required
                        >

                    </div>

                    <div class="admin-input-group">

                        <label>Descrição</label>

                        <textarea
                        name="description"
                        placeholder="Digite a descrição..."
                        required
                        ></textarea>

                    </div>

                    <div class="admin-grid">

                        <div class="admin-input-group">

                            <label>Tipo</label>

                            <input
                            type="text"
                            name="type"
                            placeholder="Filme, Série..."
                            required
                            >

                        </div>

                        <div class="admin-input-group">

                            <label>Categoria</label>

                            <input
                            type="text"
                            name="category"
                            placeholder="Ação, Terror..."
                            required
                            >

                        </div>

                    </div>

                    <div class="admin-input-group">

                    <label>Imagem URL</label>

                    <label class="custom-file-upload">

                        <input
                        type="file"
                        name="image"
                        accept="image/*"
                        required
                        id="fileInput"
                        >

                        <i class="fa-solid fa-image"></i>

                        <span id="fileName">
                            Escolher imagem
                        </span>

                    </label>

                    </div>

                    <div class="admin-input-group">

                        <label>Link do YouTube</label>

                        <input
                        type="text"
                        name="youtubeLink"
                        placeholder="https://youtube.com/..."
                        required
                        >

                    </div>

                    <button type="submit" class="admin-submit">

                        <i class="fa-solid fa-plus"></i>

                        Adicionar mídia

                    </button>

                </form>

            </div>

        </main>

    </div>

    <%- include("../partes/footer") %>

</body>
</html>