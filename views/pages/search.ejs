<!DOCTYPE html>
<html lang="pt-br">
<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Noxzon</title>

    <link rel="stylesheet" href="/css/nx-style.css">
    <link rel="icon" href="/img/noxzon-logo.jpg">

</head>
<body>

    <%- include("../partes/navbar") %>

    <section class="catalog-section">

        <h2>

            Resultados para:
            "<%= query %>"

        </h2>

        <div class="catalog-grid">

            <% medias.forEach(media => { %>

                <a
                href="/media/<%= media._id %>"
                class="media-card"
                >

                    <img
                    src="<%= media.image %>"
                    alt="<%= media.title %>"
                    >

                    <div class="media-info">

                        <span class="media-type">
                            <%= media.type %>
                        </span>

                        <h3>
                            <%= media.title %>
                        </h3>

                        <p>
                            <%= media.category %>
                        </p>

                    </div>

                </a>

            <% }) %>

        </div>

    </section>

</body>
</html>