<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Noxzon</title>

    <link rel="stylesheet" href="/css/nx-style.css">
    <link rel="icon" href="/img/noxzon-logo.jpg">
</head>
<body>

    <%- include("../partes/navbar") %>

    <section class="login-page">

        <div class="login-box">

            <h1>Criar Conta</h1>

            <p>
                Crie sua conta Noxzon.
            </p>

            <form action="/register" method="POST">

                <input
                    type="text"
                    name="username"
                    placeholder="Seu nome"
                    required
                >

                <input
                    type="email"
                    name="email"
                    placeholder="Seu email"
                    required
                >

                <input
                    type="password"
                    name="password"
                    placeholder="Sua senha"
                    required
                >

                <button type="submit">
                    Criar conta
                </button>

            </form>

        </div>

    </section>

    <%- include("../partes/footer") %>

</body>
</html>