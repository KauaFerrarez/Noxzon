<!DOCTYPE html>
<html lang="pt-br">
<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Noxzon</title>

    <link rel="stylesheet" href="/css/nx-style.css">
    <link rel="icon" href="/img/noxzon-logo.jpg">

</head>
<body>

    <%- include("../partes/navbar") %>

    <section class="media-page">

        <!-- BANNER -->

        <div
        class="media-banner"
        style="
        background-image:
        linear-gradient(
        to top,
        #050505,
        rgba(0,0,0,0.3)
        ),
        url('<%= media.image %>');
        "
        >

            <div class="media-overlay">

                <span class="media-category">

                    <%= media.category %>

                </span>

                <h1>
                    <%= media.title %>
                </h1>

                <p>
                    <%= media.description %>
                </p>

                <div class="media-buttons">

                    <a
                    href="/watch/<%= media._id %>"
                    target="_blank"
                    >

                        <button>
                            Assistir agora
                        </button>

                    <a
                    href="/favorite/<%= media._id %>"
>

                        <button class="favorite-btn">

                            ❤️ Favoritar

                        </button>

                    </a>

                    </a>

                </div>

            </div>

        </div>

    </section>
    
</body>
</html>